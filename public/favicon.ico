<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <defs>
    <linearGradient id="brand-grad" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#3b82f6" />
      <stop offset="50%" stop-color="#2563eb" />
      <stop offset="100%" stop-color="#1d4ed8" />
    </linearGradient>
    <linearGradient id="bar-grad" x1="0" y1="0" x2="0" y2="64" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#e0e7ff" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%" filterUnits="userSpaceOnUse">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#0f172a" flood-opacity="0.25"/>
    </filter>
  </defs>
  
  <!-- Outer Rounded Squircle -->
  <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#brand-grad)" />
  <rect x="2" y="2" width="60" height="60" rx="16" stroke="#60a5fa" stroke-width="1.5" stroke-opacity="0.4" />
  
  <!-- Baseline grid line -->
  <path d="M12 50h40" stroke="#ffffff" stroke-opacity="0.2" stroke-width="1.5" stroke-linecap="round" />
  
  <!-- Three Rising Pillars -->
  <!-- Left Pillar -->
  <rect x="14" y="30" width="9" height="20" rx="2.5" fill="url(#bar-grad)" filter="url(#shadow)" />
  
  <!-- Center Pillar -->
  <rect x="27.5" y="20" width="9" height="30" rx="2.5" fill="url(#bar-grad)" filter="url(#shadow)" />
  
  <!-- Right Pillar -->
  <rect x="41" y="14" width="9" height="36" rx="2.5" fill="url(#bar-grad)" filter="url(#shadow)" />

  <!-- Accent indicator dot on the right peak -->
  <circle cx="45.5" cy="18.5" r="1.5" fill="#38bdf8" />
</svg>
